}

/* ═══ Stock hint ═══ */
async function updateStockHint() {
  const k = $('outKode').value; if (!k) { $('stockHint').textContent = ''; return; }
  $('stockHint').textContent = `المتاح حالياً: ${computeBatches(await getTrx(), k).stok}`;
}
$('outKode').addEventListener('change', updateStockHint);

