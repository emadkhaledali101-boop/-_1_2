function pad(n) { return String(n).padStart(2, '0'); }
function parseManualDate(str) {
  if (!str) return null;
  str = str.trim();
  let y, mo, d;
  let m = str.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})$/);
  if (m) { y = +m[1]; mo = +m[2]; d = +m[3]; }
  else {
    m = str.match(/^(\d{1,2})[-\/](\d{1,2})[-\/](\d{4})$/);
    if (!m) return null;
    y = +m[3]; mo = +m[2]; d = +m[1];
  }
  if (mo < 1 || mo > 12 || d < 1 || d > 31) return null;
  const test = new Date(y, mo - 1, d);
  if (test.getFullYear() !== y || test.getMonth() !== mo - 1 || test.getDate() !== d) return null;
  return { y, mo, d };
}
function fmtDate(p) { return p ? `${p.y}-${pad(p.mo)}-${pad(p.d)}` : ''; }
function dateToStr(d) { return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; }
function todayStr() { return dateToStr(new Date()); }
function todayCompact() { return todayStr().replace(/-/g, ''); }
function addMonths(base, months) { return dateToStr(new Date(base.getFullYear(), base.getMonth() + months, base.getDate())); }
function setToday(id) { $(id).value = todayStr(); }
function setYesterday(id) { $(id).value = dateToStr(new Date(Date.now() - 864e5)); }
function setTomorrow(id) { $(id).value = dateToStr(new Date(Date.now() + 864e5)); }
function quickExp(months) { $('inExp').value = addMonths(new Date(), months); }
function parseToDate(str) { const p = parseManualDate(str); return p ? new Date(p.y, p.mo - 1, p.d) : null; }

