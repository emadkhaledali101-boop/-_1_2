      <button class="theme-btn" onclick="toggleTheme()" aria-label="تبديل الوضع" title="نهاري / ليلي"></button>
      <div class="who">
        <span id="userEmail">...</span>
        <button onclick="doLogout()">تسجيل خروج</button>
      </div>
    </div>
  </div>

  <nav>
    <button data-tab="dashboard" class="active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg><span>لوحة التحكم</span></button>
    <button data-tab="inventory"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><path d="m3.3 7 8.7 5 8.7-5"/></svg><span>المخزن</span></button>
    <button data-tab="masuk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 17V3"/><path d="m6 11 6 6 6-6"/><path d="M19 21H5"/></svg><span>تسجيل وارد</span></button>
    <button data-tab="keluar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 9-6-6-6 6"/><path d="M12 3v14"/><path d="M5 21h14"/></svg><span>تسجيل صادر</span></button>
    <button data-tab="logIn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg><span>سجل الوارد</span></button>
    <button data-tab="logOut"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M12 12v6"/><path d="m15 15-3-3-3 3"/></svg><span>سجل الصرف</span></button>
    <button data-tab="consume"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg><span>معدل الاستهلاك</span></button>
    <button data-tab="reports"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg><span>التقارير</span></button>
    <button data-tab="manage"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></svg><span>إدارة الأصناف</span></button>
    <button data-tab="alerts"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg><span>التنبيهات</span></button>
    <button data-tab="backup"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg><span>النسخ الاحتياطي</span></button>
  </nav>

  <!-- لوحة التحكم -->
  <section id="dashboard" class="panel active">
    <div class="stat-grid">
      <div class="stat"><div class="num" id="stTotal">0</div><div class="lbl">أصناف</div></div>
      <div class="stat warn"><div class="num" id="stLow">0</div><div class="lbl">ناقصة</div></div>
      <div class="stat danger"><div class="num" id="stOut">0</div><div class="lbl">خالصة</div></div>
      <div class="stat exp"><div class="num" id="stExp">0</div><div class="lbl">قريبة الانتهاء</div></div>
    </div>
    <div id="dashAlerts"></div>
    <div class="card">
      <h2>آخر الحركات</h2>
      <div class="scroll-x">
        <table>
          <thead><tr><th>رقم</th><th>النوع</th><th>الدوا</th><th>الكمية</th><th>التاريخ</th><th>المستخدم</th><th>ملاحظة</th></tr></thead>
          <tbody id="tbodyTrx"></tbody>
        </table>
      </div>
      <div id="emptyTrx" class="empty" style="display:none">مفيش حركات بعد</div>
    </div>
  </section>

  <!-- المخزن -->
  <section id="inventory" class="panel">
    <div class="card">
      <h2>الأدوية في المخزن</h2>
      <div class="search-bar"><input id="invSearch" placeholder="ابحث بالاسم أو الكود..." oninput="renderInventory()"></div>
      <div class="btn-row" style="margin-top:12px">
        <button class="btn-excel" onclick="exportInventoryExcel()">تصدير Excel</button>
        <button class="btn-print" onclick="printSection('inventoryTable')">طباعة</button>
      </div>
      <div class="scroll-x" id="inventoryTable">
        <table>
          <thead><tr><th>الكود</th><th>الاسم</th><th>الفئة</th><th>الرصيد</th><th>الوحدة</th><th>الحد الأدنى</th><th>الحالة</th></tr></thead>
          <tbody id="tbodyInventory"></tbody>
        </table>
      </div>
      <div id="emptyInventory" class="empty" style="display:none">مفيش أدوية في المخزن</div>
    </div>
  </section>

  <!-- وارد -->
  <section id="masuk" class="panel">
    <div class="card">
      <h2>تسجيل وارد</h2>
      <label>كود الدوا</label>
      <select id="inKode"></select>
      <div class="row">
        <div><label>الكمية</label><input id="inJumlah" type="number" min="1" placeholder="200"></div>
        <div><label>رقم الباتش</label><input id="inBatch" placeholder="BATCH-2510A"></div>
      </div>
      <label>تاريخ الانتهاء</label>
      <input id="inExp" type="date">
      <div class="quick-date">
        <button type="button" onclick="quickExp(6)">+6 شهور</button>
        <button type="button" onclick="quickExp(12)">+سنة</button>
        <button type="button" onclick="quickExp(24)">+سنتين</button>
        <button type="button" onclick="quickExp(36)">+3 سنين</button>
      </div>
      <label>تاريخ الاستلام</label>
      <input id="inTanggal" type="date">
      <div class="quick-date">
        <button type="button" onclick="setToday('inTanggal')">اليوم</button>
        <button type="button" onclick="setYesterday('inTanggal')">أمس</button>
        <button type="button" onclick="setTomorrow('inTanggal')">غداً</button>
      </div>
      <label>المورد</label>
      <input id="inSupplier" placeholder="شركة النيل للأدوية">
      <label>ملاحظة</label>
      <input id="inNote" placeholder="اختياري">
      <button class="btn green" onclick="submitMasuk(this)">تسجيل وارد</button>
      <div id="msgMasuk" class="msg"></div>
    </div>
  </section>

  <!-- صادر -->
  <section id="keluar" class="panel">
    <div class="card">
      <h2>تسجيل صادر</h2>
      <label>كود الدوا</label>
      <select id="outKode"></select>
      <label>الكمية</label>
      <input id="outJumlah" type="number" min="1" placeholder="30">
      <div class="hint" id="stockHint"></div>
      <label>الجهة / المريض</label>
      <input id="outTujuan" placeholder="مريض أحمد">
      <label>رقم الروشتة</label>
      <input id="outResep" placeholder="RX-2025-001">
      <label>تاريخ الصرف</label>
      <input id="outTanggal" type="date">
      <div class="quick-date">
        <button type="button" onclick="setToday('outTanggal')">اليوم</button>
        <button type="button" onclick="setYesterday('outTanggal')">أمس</button>
        <button type="button" onclick="setTomorrow('outTanggal')">غداً</button>
      </div>
      <label>ملاحظة</label>
      <input id="outNote" placeholder="اختياري">
      <button class="btn red" onclick="submitKeluar(this)">تسجيل صادر</button>
      <div id="msgKeluar" class="msg"></div>
    </div>
  </section>

  <!-- سجل الوارد -->
  <section id="logIn" class="panel">
    <div class="card">
      <h2>سجل الوارد</h2>
      <div class="row">
        <div><label>من تاريخ</label><input id="logInFrom" type="date" oninput="renderLogIn()"></div>
        <div><label>إلى تاريخ</label><input id="logInTo" type="date" oninput="renderLogIn()"></div>
      </div>
      <div class="search-bar" style="margin-top:8px"><input id="logInSearch" placeholder="ابحث باسم الدوا..." oninput="renderLogIn()"></div>
      <div class="btn-row" style="margin-top:12px">
        <button class="btn-excel" onclick="exportLogInExcel()">تصدير Excel</button>
        <button class="btn-print" onclick="printSection('logInTable')">طباعة</button>
      </div>
      <div class="scroll-x" id="logInTable">
        <table>
          <thead><tr><th>رقم</th><th>الدوا</th><th>الكمية</th><th>الباتش</th><th>الانتهاء</th><th>المورد</th><th>تاريخ الاستلام</th><th>المستخدم</th><th>ملاحظة</th><th class="noprint">إجراء</th></tr></thead>
          <tbody id="tbodyLogIn"></tbody>
        </table>
      </div>
      <div id="emptyLogIn" class="empty" style="display:none">مفيش واردات</div>
    </div>
  </section>

  <!-- سجل الصرف -->
  <section id="logOut" class="panel">
    <div class="card">
      <h2>سجل الصرف</h2>
      <div class="row">
        <div><label>من تاريخ</label><input id="logOutFrom" type="date" oninput="renderLogOut()"></div>
        <div><label>إلى تاريخ</label><input id="logOutTo" type="date" oninput="renderLogOut()"></div>
      </div>
      <div class="search-bar" style="margin-top:8px"><input id="logOutSearch" placeholder="ابحث باسم الدوا..." oninput="renderLogOut()"></div>
      <div class="btn-row" style="margin-top:12px">
        <button class="btn-excel" onclick="exportLogOutExcel()">تصدير Excel</button>
        <button class="btn-print" onclick="printSection('logOutTable')">طباعة</button>
      </div>
      <div class="scroll-x" id="logOutTable">
        <table>
          <thead><tr><th>رقم</th><th>الدوا</th><th>الكمية</th><th>الجهة</th><th>الروشتة</th><th>تاريخ الصرف</th><th>المستخدم</th><th>ملاحظة</th><th class="noprint">إجراء</th></tr></thead>
          <tbody id="tbodyLogOut"></tbody>
        </table>
      </div>
      <div id="emptyLogOut" class="empty" style="display:none">مفيش صرف</div>
    </div>
  </section>

  <!-- معدل الاستهلاك -->
  <section id="consume" class="panel">
    <div class="card">
      <h2>معدل الاستهلاك الشهري</h2>
      <div class="row">
        <div><label>من تاريخ</label><input id="cFrom" type="date"></div>
        <div><label>إلى تاريخ</label><input id="cTo" type="date"></div>
      </div>
      <div class="quick-date">
        <button type="button" onclick="setConsRange('3m')">آخر 3 شهور</button>
        <button type="button" onclick="setConsRange('6m')">آخر 6 شهور</button>
        <button type="button" onclick="setConsRange('12m')">آخر سنة</button>
        <button type="button" onclick="setConsRange('year')">السنة الحالية</button>
      </div>
      <button class="btn purple" onclick="generateConsumption()">احسب المعدل</button>
      <div id="msgCons" class="msg"></div>
      <div id="consSummary" class="sum-line"></div>
      <div class="btn-row" style="margin-top:14px">
        <button class="btn-excel" onclick="exportConsExcel()">تصدير Excel</button>
        <button class="btn-print" onclick="printSection('consTable')">طباعة</button>
      </div>
      <div class="scroll-x" id="consTable">
        <table>
          <thead><tr><th>الكود</th><th>الاسم</th><th>الفئة</th><th>إجمالي الصرف</th><th>المعدل الشهري</th><th>الرصيد الحالي</th><th>يكفي لمدة</th><th>الحالة</th></tr></thead>
          <tbody id="tbodyCons"></tbody>
        </table>
      </div>
      <div id="emptyCons" class="empty">اختار الفترة واضغط "احسب المعدل"</div>
      <div class="hint">المعدل الشهري = إجمالي الصرف ÷ عدد شهور الفترة (الفترة بالأيام ÷ 30.44). "يكفي لمدة" = الرصيد الحالي ÷ المعدل الشهري.</div>
    </div>
  </section>

  <!-- التقارير -->
  <section id="reports" class="panel">
    <div class="card">
      <h2>تقرير حركة الأصناف</h2>
      <div class="row">
        <div><label>من تاريخ</label><input id="rptFrom" type="date"></div>
        <div><label>إلى تاريخ</label><input id="rptTo" type="date"></div>
      </div>
      <button class="btn purple" onclick="generateReport()">توليد التقرير</button>
      <div class="btn-row" style="margin-top:12px">
        <button class="btn-excel" onclick="exportReportExcel()">تصدير Excel</button>
        <button class="btn-print" onclick="printSection('reportTable')">طباعة</button>
      </div>
      <div class="scroll-x" id="reportTable">
        <table>
          <thead><tr><th>الكود</th><th>الاسم</th><th>وارد</th><th>صادر</th><th>الرصيد الحالي</th><th>الحالة</th></tr></thead>
          <tbody id="tbodyReport"></tbody>
        </table>
      </div>
      <div id="emptyReport" class="empty">اختار الفترة واضغط توليد</div>
    </div>
    <div class="card">
      <h2>إحصائيات سريعة</h2>
      <div id="quickStats"></div>
    </div>
  </section>

  <!-- الإدارة -->
  <section id="manage" class="panel">
    <div class="card">
      <h2>بحث سريع</h2>
      <div class="search-bar"><input id="searchAll" placeholder="اكتب اسم أو كود أو باركود..." oninput="renderAllLists()"></div>
    </div>
    <div class="card">
      <h2>الأصناف</h2>
      <button class="btn" onclick="openObatForm()">إضافة صنف جديد</button>
      <div class="scroll-x" style="margin-top:12px">
        <table>
          <thead><tr><th>كود</th><th>الاسم</th><th>الفئة</th><th>الباركود</th><th>الحد الأدنى</th><th>إجراءات</th></tr></thead>
          <tbody id="tbodyObatMg"></tbody>
        </table>
      </div>
      <div id="emptyObatMg" class="empty" style="display:none">مفيش أصناف</div>
    </div>
    <div class="card">
      <h2>كل الحركات</h2>
      <div class="scroll-x">
        <table>
          <thead><tr><th>رقم</th><th>النوع</th><th>الدوا</th><th>الكمية</th><th>التاريخ</th><th>المستخدم</th><th>ملاحظة</th><th>إجراء</th></tr></thead>
          <tbody id="tbodyTrxMg"></tbody>
        </table>
      </div>
      <div id="emptyTrxMg" class="empty" style="display:none">مفيش حركات</div>
    </div>
    <div class="card">
      <h2>الرصيد التفصيلي (FIFO)</h2>
      <div id="batchView"></div>
    </div>
  </section>

  <!-- التنبيهات -->
  <section id="alerts" class="panel">
    <div class="card"><h2>تنبيهات انتهاء الصلاحية</h2><div id="expiryAlerts"></div></div>
    <div class="card"><h2>تنبيهات نقص المخزون</h2><div id="stockAlerts"></div></div>
    <div class="card">
      <h2>بحث بالباركود</h2>
      <label>امسح أو اكتب الباركود</label>
      <input id="barcodeSearch" placeholder="SCAN..." oninput="barcodeLookup()">
      <div id="barcodeResult" class="hint"></div>
    </div>
  </section>

  <!-- النسخ الاحتياطي -->
  <section id="backup" class="panel">
    <div class="card">
      <h2>النسخ الاحتياطي</h2>
      <label>اسم للنسخة (اختياري)</label>
      <input id="backupLabel" placeholder="مثال: قبل الجرد">
      <div class="btn-row" style="margin-top:14px">
        <button class="btn-excel" onclick="saveBackupNow()">حفظ نسخة الآن</button>
        <button class="btn-print" onclick="exportData()">تنزيل كملف JSON</button>
      </div>
      <div class="bk-auto">
        <label class="switch-line"><input type="checkbox" id="autoBackupOn" onchange="saveAutoBackupSettings()"><span>نسخة تلقائية يوميًا الساعة</span></label>
        <input type="time" id="autoBackupTime" value="22:00" onchange="saveAutoBackupSettings()">
      </div>
      <div class="hint">النسخ بتتحفظ في المتصفح ده بس. النسخ التلقائي بيشتغل طول ما الصفحة مفتوحة، ولو مفتوحة بعد الوقت اللي اخترته بياخد نسخة أول ما تفتحها. لحفظ نسخة خارج المتصفح استخدم "تنزيل كملف JSON".</div>
      <div id="msgBackup" class="msg"></div>
    </div>
    <div class="card"><h2>النسخ المحفوظة</h2><div id="backupList"></div></div>
    <div class="card">
      <h2>استيراد ملف نسخة</h2>
      <input type="file" id="importFile" accept="application/json">
      <div class="hint">الاستيراد بيضيف الأصناف والحركات الناقصة بس، ومش بيكرر الحركات الموجودة.</div>
    </div>
    <div class="card danger-zone">
      <h2>منطقة الخطر</h2>
      <button class="btn red" style="margin-top:0" onclick="wipeAll()">مسح كل البيانات</button>
      <button class="btn red" onclick="wipeTrx()">مسح الحركات فقط</button>
    </div>
  </section>

</div>

<!-- نافذة الأصناف -->
<div id="modalObat" class="modal-bg">
  <div class="modal">
    <h2 id="modalObatTitle">إضافة صنف</h2>
    <label>الكود</label><input id="mObKode" placeholder="OBT-003">
    <label>الاسم</label><input id="mObNama" placeholder="إيبوبروفين">
    <label>الباركود</label><input id="mObBarcode" placeholder="6221031456789">
    <div class="row">
      <div><label>الفئة</label><input id="mObKategori" placeholder="مسكن"></div>
      <div><label>الوحدة</label><input id="mObUnit" placeholder="قرص"></div>
    </div>
    <div class="row">
      <div><label>الحد الأدنى</label><input id="mObMin" type="number" min="0" value="10"></div>
      <div><label>سعر الشراء</label><input id="mObBeli" type="number" step="0.01" value="0"></div>
      <div><label>سعر البيع</label><input id="mObJual" type="number" step="0.01" value="0"></div>
    </div>
    <label>ملاحظة</label><input id="mObNote" placeholder="اختياري">
    <div class="row" style="margin-top:16px">
      <button class="btn green" onclick="saveObat()">حفظ</button>
      <button class="btn gray" onclick="closeObatForm()">إلغاء</button>
    </div>
    <div id="msgModal" class="msg"></div>
  </div>
</div>

<!-- نافذة تعديل حركة -->
<div id="modalTrx" class="modal-bg">
  <div class="modal">
    <h2 id="mtTitle">تعديل حركة</h2>
    <div class="sub" id="mtDrug"></div>
    <div class="row">
      <div><label>الكمية</label><input id="mtQty" type="number" min="1"></div>
      <div><label id="mtDateLbl">التاريخ</label><input id="mtDate" type="date"></div>
    </div>
    <div class="g-in">
      <div class="row">
        <div><label>رقم الباتش</label><input id="mtBatch"></div>
        <div><label>تاريخ الانتهاء</label><input id="mtExp" type="date"></div>
      </div>
      <label>المورد</label><input id="mtSupplier">
    </div>
    <div class="g-out">
      <label>الجهة / المريض</label><input id="mtTujuan">
      <label>رقم الروشتة</label><input id="mtResep">
    </div>
