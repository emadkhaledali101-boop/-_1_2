    });
    if (net < 0) { showMsg('msgTrx', 'التعديل ده هيخلي رصيد الصنف بالسالب. راجع الكمية.', false); btn.disabled = false; return; }

    const timePart = (t.tanggal || '').split('T')[1] || '00:00:00';
    const fields = { jumlah: qty, tanggal: fmtDate(pDate) + 'T' + timePart, note: $('mtNote').value.trim() };
    if (isIn) {
      fields.batch = $('mtBatch').value.trim();
      fields.exp = exp;
      fields.supplier = $('mtSupplier').value.trim();
    } else {
      fields.tujuan = $('mtTujuan').value.trim();
      fields.resep = $('mtResep').value.trim();
    }
    await dbUpdateTrx(t.id, fields);
    clearCache();
    closeTrxEdit();
    toast('تم حفظ التعديل');
    refreshAll();
  } catch (err) {
    showMsg('msgTrx', 'خطأ: ' + err.message, false);
  }
  btn.disabled = false;
}

