setToday('inTanggal'); setToday('outTanggal');
$('cFrom').value = addMonths(new Date(), -3); $('cTo').value = todayStr();
$('loginPass').addEventListener('keypress', e => { if (e.key === 'Enter') doLogin(); });
document.addEventListener('click', e => {
  const t = e.target;
  if (t && t.matches && t.matches('input[type="date"], input[type="time"]')) { try { t.showPicker(); } catch (err) {} }
  if (t && t.classList && t.classList.contains('modal-bg')) { t.classList.remove('show'); editingTrx = null; }
});
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') document.querySelectorAll('.modal-bg.show').forEach(m => m.classList.remove('show'));
});

/* ═══ النسخ الاحتياطي المحلي ═══ */
const BK_KEY = 'medsys_backups_v1', BK_AUTO_KEY = 'medsys_autobackup_v1', BK_MAX = 15;
function bkLoad() { try { return JSON.parse(localStorage.getItem(BK_KEY) || '[]'); } catch (e) { return []; } }
function bkWhen(iso) { const d = new Date(iso); return `${dateToStr(d)} ${pad(d.getHours())}:${pad(d.getMinutes())}`; }

async function saveBackupNow(auto) {
  try {
    const obat = await getObats(true), transaksi = await getTrx(true);
    const labelEl = $('backupLabel');
    const label = auto === true ? '' : (labelEl ? labelEl.value.trim() : '');
    const nowIso = new Date().toISOString();
    const list = bkLoad();
    list.push({ id: Date.now(), ts: nowIso, label, auto: auto === true, nObat: obat.length, nTrx: transaksi.length, data: { obat, transaksi, exported: nowIso, version: 4 } });
    let dropped = 0;
    while (list.length > BK_MAX) { list.shift(); dropped++; }
    let saved = false;
    while (!saved) {
      try { localStorage.setItem(BK_KEY, JSON.stringify(list)); saved = true; }
      catch (e) { if (list.length <= 1) break; list.shift(); dropped++; }
    }
    if (!saved) { showMsg('msgBackup', 'المساحة في المتصفح مش كفاية. نزّل النسخة كملف JSON.', false); return; }
    if (labelEl && auto !== true) labelEl.value = '';
    showMsg('msgBackup', (auto === true ? 'تم حفظ النسخة التلقائية.' : 'تم حفظ النسخة.') + (dropped ? ` اتمسحت ${dropped} نسخة قديمة عشان المساحة.` : ''), true);
    renderBackups();
  } catch (err) { showMsg('msgBackup', 'خطأ في حفظ النسخة: ' + err.message, false); }
}

function renderBackups() {
  const el = $('backupList'); if (!el) return;
  const list = bkLoad().slice().reverse();
  if (!list.length) { el.innerHTML = '<div class="empty">مفيش نسخ محفوظة. اضغط "حفظ نسخة الآن" لأول نسخة.</div>'; return; }
  el.innerHTML = list.map(b => {
    const kb = Math.max(1, Math.round(JSON.stringify(b.data).length / 1024));
    const title = b.label ? escHtml(b.label) : (b.auto ? 'نسخة تلقائية' : 'نسخة يدوية');
    return `<div class="bk-item">
      <div><div class="bk-title">${title}${b.auto ? '<span class="bk-tag">تلقائي</span>' : ''}</div>
        <div class="bk-meta">${bkWhen(b.ts)} · ${b.nObat} صنف · ${b.nTrx} حركة · ${kb} ك.ب</div></div>
      <div class="bk-actions">
        <button onclick="downloadBackup(${b.id})">تنزيل</button>
        <button onclick="restoreBackup(${b.id})">استرجاع</button>
        <button class="danger" onclick="deleteBackup(${b.id})">حذف</button>
      </div></div>`;
  }).join('');
}

function downloadBackup(id) {
  const b = bkLoad().find(x => x.id === id); if (!b) return;
  const d = new Date(b.ts);
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([JSON.stringify(b.data, null, 2)], { type: 'application/json' }));
  a.download = `sistem-obat-${todayCompact()}-${pad(d.getHours())}${pad(d.getMinutes())}.json`; a.click();
}
async function restoreBackup(id) {
  const b = bkLoad().find(x => x.id === id); if (!b) return;
  if (!confirm(`استرجاع نسخة ${bkWhen(b.ts)}؟\nهيتضاف أي صنف أو حركة ناقصة، ومش هيتمسح حاجة موجودة.`)) return;
  try {
    const res = await restoreData(b.data);
    showMsg('msgBackup', `تم الاسترجاع: ${res.addedO} صنف و${res.addedT} حركة اتضافوا.`, true);
    refreshAll();
  } catch (err) { showMsg('msgBackup', 'خطأ في الاسترجاع: ' + err.message, false); }
}
function deleteBackup(id) {
  if (!confirm('حذف النسخة دي؟')) return;
  try { localStorage.setItem(BK_KEY, JSON.stringify(bkLoad().filter(x => x.id !== id))); } catch (e) {}
  renderBackups();
}
async function restoreData(data) {
  let addedO = 0, addedT = 0;
  if (Array.isArray(data.obat)) for (const o of data.obat) { await dbPutObat(o); addedO++; }
  if (Array.isArray(data.transaksi)) {
    const existing = new Set((await getTrx(true)).map(t => t.nomor));
    for (const t of data.transaksi) {
      if (existing.has(t.nomor)) continue;
      await dbPutTrx(t); addedT++;
    }
  }
  clearCache();
  return { addedO, addedT };
}

function bkAutoLoad() {
  const def = { on: false, time: '22:00', last: '' };
  try { return Object.assign(def, JSON.parse(localStorage.getItem(BK_AUTO_KEY) || '{}')); } catch (e) { return def; }
}
function bkAutoStore(s) { try { localStorage.setItem(BK_AUTO_KEY, JSON.stringify(s)); } catch (e) {} }
function saveAutoBackupSettings() {
  const s = bkAutoLoad();
  s.on = $('autoBackupOn').checked; s.time = $('autoBackupTime').value || '22:00';
  bkAutoStore(s);
}
function initAutoBackupUI() {
  const s = bkAutoLoad();
  $('autoBackupOn').checked = !!s.on; $('autoBackupTime').value = s.time;
}
async function autoBackupTick() {
  const s = bkAutoLoad();
  if (!s.on || $('appWrap').style.display !== 'block') return;
  const now = new Date();
  const hm = pad(now.getHours()) + ':' + pad(now.getMinutes());
  if (s.last === todayStr() || hm < s.time) return;
  s.last = todayStr(); bkAutoStore(s);
  await saveBackupNow(true);
}
setInterval(autoBackupTick, 30000);
setTimeout(autoBackupTick, 4000);
initAutoBackupUI();
renderBackups();

