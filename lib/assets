/* ═══ التنبيهات ═══ */
function nearExpiryList(trx, months) {
  const today = new Date();
  const limit = new Date(today.getFullYear(), today.getMonth() + months, today.getDate());
  const result = [];
  const kodes = [...new Set(trx.filter(t => t.tipe === 'وارد').map(t => t.kode))];
  kodes.forEach(kode => {
    computeBatches(trx, kode).batches.forEach(b => {
      if (b.remaining <= 0 || !b.exp) return;
      const d = parseToDate(b.exp);
      if (!d) return;
      if (d <= limit) result.push({ kode, nama: b.nama, batch: b.batch, exp: b.exp, remaining: b.remaining, days: Math.ceil((d - today) / 864e5) });
    });
  });
  return result.sort((a, b) => a.days - b.days);
}

