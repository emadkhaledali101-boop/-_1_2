/* ═══ FIFO ═══ */
function computeBatches(trx, kode) {
  const byDate = (a, b) => (a.tanggal || '').localeCompare(b.tanggal || '') || a.id - b.id;
  const batches = trx.filter(t => t.kode === kode && t.tipe === 'وارد').sort(byDate).map(b => ({ ...b, remaining: b.jumlah }));
  trx.filter(t => t.kode === kode && t.tipe === 'صادر').sort(byDate).forEach(o => {
    let need = o.jumlah;
    for (const b of batches) {
      if (need <= 0) break;
      if (b.remaining <= 0) continue;
      const take = Math.min(b.remaining, need);
      b.remaining -= take; need -= take;
    }
  });
  return { batches, stok: batches.reduce((s, b) => s + b.remaining, 0) };
}
function computeAllStocks(obats, trx) {
  const map = {};
  obats.forEach(o => { map[o.kode] = computeBatches(trx, o.kode).stok; });
  return map;
}

