let _lastCons = [], _lastConsMeta = null;

function setConsRange(kind) {
  const now = new Date();
  let from;
  if (kind === '3m') from = addMonths(now, -3);
  else if (kind === '6m') from = addMonths(now, -6);
  else if (kind === '12m') from = addMonths(now, -12);
  else from = `${now.getFullYear()}-01-01`;
  $('cFrom').value = from; $('cTo').value = todayStr();
  generateConsumption();
}

async function generateConsumption() {
  const from = $('cFrom').value, to = $('cTo').value;
  if (!from || !to) { showMsg('msgCons', 'اختار تاريخ البداية والنهاية.', false); return; }
  if (from > to) { showMsg('msgCons', 'تاريخ البداية لازم يكون قبل النهاية.', false); return; }

  const days = Math.round((new Date(to + 'T00:00:00') - new Date(from + 'T00:00:00')) / 864e5) + 1;
  const months = days / 30.4375;

  const obats = await getObats(), trx = await getTrx();
  const stokMap = computeAllStocks(obats, trx);
  const outs = trx.filter(t => t.tipe === 'صادر' && (t.tanggal || '').slice(0, 10) >= from && (t.tanggal || '').slice(0, 10) <= to);

  _lastCons = obats.map(o => {
    const total = outs.filter(t => t.kode === o.kode).reduce((s, t) => s + t.jumlah, 0);
    const monthly = total / months;
    const stock = stokMap[o.kode] || 0;
    const cover = monthly > 0 ? stock / monthly : null;
    return { kode: o.kode, nama: o.nama, kategori: o.kategori || '', unit: o.unit || '', total, monthly, stock, cover };
  }).sort((a, b) => b.monthly - a.monthly);
  _lastConsMeta = { from, to, days, months };

  $('tbodyCons').innerHTML = _lastCons.map(r => {
    let cov, cls, lbl;
    if (r.cover === null) { cov = '—'; cls = 'ok'; lbl = 'بدون استهلاك'; }
    else {
      cov = r.cover.toFixed(1) + ' شهر';
      if (r.cover < 1) { cls = 'out'; lbl = 'أقل من شهر'; }
      else if (r.cover < 3) { cls = 'low'; lbl = 'يحتاج طلب'; }
      else { cls = 'ok'; lbl = 'كافي'; }
    }
    return `<tr><td>${escHtml(r.kode)}</td><td>${escHtml(r.nama)}</td><td>${escHtml(r.kategori || '-')}</td>
      <td>${r.total}</td><td><strong>${r.monthly.toFixed(1)}</strong> ${escHtml(r.unit)}</td><td>${r.stock}</td><td>${cov}</td>
      <td><span class="badge ${cls}">${lbl}</span></td></tr>`;
  }).join('');
  $('emptyCons').style.display = _lastCons.length ? 'none' : 'block';
  const sumTotal = _lastCons.reduce((s, r) => s + r.total, 0);
  $('consSummary').innerHTML = `<span class="pill">من ${from} إلى ${to}</span><span class="pill">${days} يوم ≈ ${months.toFixed(2)} شهر</span><span class="pill">إجمالي المصروف: ${sumTotal}</span>`;
}

function exportConsExcel() {
  if (!_lastCons.length) { alert('احسب المعدل الأول'); return; }
  const m = _lastConsMeta;
  const rows = [
    ['معدل الاستهلاك الشهري'],
    ['من', m.from, 'إلى', m.to, 'عدد الشهور', m.months.toFixed(2)],
    [],
    ['الكود', 'الاسم', 'الفئة', 'إجمالي الصرف', 'المعدل الشهري', 'الوحدة', 'الرصيد الحالي', 'يكفي لمدة (شهر)']
  ];
  _lastCons.forEach(r => rows.push([r.kode, r.nama, r.kategori, r.total, r.monthly.toFixed(2), r.unit, r.stock, r.cover === null ? '' : r.cover.toFixed(1)]));
  downloadCSV(`consumption-${m.from}_to_${m.to}.csv`, rows);
}

